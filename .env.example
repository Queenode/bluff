# ---- public (shipped to the browser) ----
NEXT_PUBLIC_NETWORK_ID=testnet
NEXT_PUBLIC_CONTRACT_ID=bluff-arena-76371.testnet
NEXT_PUBLIC_RPC_URL=https://test.rpc.fastnear.com

# ---- server only (judge / oracle) ----
# Account whose key the contract accepts for arm_room / judge_attempt
ORACLE_ACCOUNT_ID=
ORACLE_PRIVATE_KEY=ed25519:...
# 32+ random bytes, e.g. `openssl rand -hex 32`. Changing it changes every room's secret code.
CANARY_SECRET=
# Any OpenAI-compatible endpoint. NEAR AI Cloud gives TEE-signed completions.
LLM_BASE_URL=https://cloud-api.near.ai/v1
LLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
LLM_API_KEY=
